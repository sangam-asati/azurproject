{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "sangamadf1"
		},
		"ls_sink_path_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_sink_path'"
		},
		"ls_sink_sql_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sink_sql'"
		},
		"ls_sink_sql_new_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_sink_sql_new'"
		},
		"ls_source_path_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_source_path'"
		},
		"ls_rest_api_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://dummyjson.com/products"
		},
		"ls_sink_path_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sangamsc.dfs.core.windows.net/"
		},
		"ls_sink_sql_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sangamsqlser.database.windows.net"
		},
		"ls_sink_sql_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sangamDB"
		},
		"ls_sink_sql_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"ls_sink_sql_new_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "sangamsqlser.database.windows.net"
		},
		"ls_sink_sql_new_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sangamDB"
		},
		"ls_sink_sql_new_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sqladmin"
		},
		"ls_source_path_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://sangamsc.dfs.core.windows.net/"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "sangamadf1_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_sink_path_accountKey": {
						"value": "[parameters('ls_sink_path_accountKey')]"
					},
					"ls_sink_sql_password": {
						"value": "[parameters('ls_sink_sql_password')]"
					},
					"ls_sink_sql_new_password": {
						"value": "[parameters('ls_sink_sql_new_password')]"
					},
					"ls_source_path_accountKey": {
						"value": "[parameters('ls_source_path_accountKey')]"
					},
					"ls_rest_api_properties_typeProperties_url": {
						"value": "[parameters('ls_rest_api_properties_typeProperties_url')]"
					},
					"ls_sink_path_properties_typeProperties_url": {
						"value": "[parameters('ls_sink_path_properties_typeProperties_url')]"
					},
					"ls_sink_sql_properties_typeProperties_server": {
						"value": "[parameters('ls_sink_sql_properties_typeProperties_server')]"
					},
					"ls_sink_sql_properties_typeProperties_database": {
						"value": "[parameters('ls_sink_sql_properties_typeProperties_database')]"
					},
					"ls_sink_sql_properties_typeProperties_userName": {
						"value": "[parameters('ls_sink_sql_properties_typeProperties_userName')]"
					},
					"ls_sink_sql_new_properties_typeProperties_server": {
						"value": "[parameters('ls_sink_sql_new_properties_typeProperties_server')]"
					},
					"ls_sink_sql_new_properties_typeProperties_database": {
						"value": "[parameters('ls_sink_sql_new_properties_typeProperties_database')]"
					},
					"ls_sink_sql_new_properties_typeProperties_userName": {
						"value": "[parameters('ls_sink_sql_new_properties_typeProperties_userName')]"
					},
					"ls_source_path_properties_typeProperties_url": {
						"value": "[parameters('ls_source_path_properties_typeProperties_url')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}