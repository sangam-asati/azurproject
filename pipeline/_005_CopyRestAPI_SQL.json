{
	"name": "_005_CopyRestAPI_SQL",
	"properties": {
		"activities": [
			{
				"name": "CopyDataWebToSQL",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "RestSource",
						"httpRequestTimeout": "00:01:40",
						"requestInterval": "00.00:00:00.010",
						"requestMethod": "GET",
						"paginationRules": {
							"supportRFC5988": "true"
						}
					},
					"sink": {
						"type": "AzureSqlSink",
						"writeBehavior": "insert",
						"sqlWriterUseTableLock": false,
						"tableOption": "autoCreate",
						"disableMetricsCollection": false
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "['id']"
								},
								"sink": {
									"name": "id",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "['title']"
								},
								"sink": {
									"name": "title",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['description']"
								},
								"sink": {
									"name": "description",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['category']"
								},
								"sink": {
									"name": "category",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "['price']"
								},
								"sink": {
									"name": "price",
									"type": "Double"
								}
							},
							{
								"source": {
									"path": "['discountPercentage']"
								},
								"sink": {
									"name": "discountPercentage",
									"type": "Double"
								}
							},
							{
								"source": {
									"path": "['rating']"
								},
								"sink": {
									"name": "products'][0]['rating",
									"type": "Double"
								}
							},
							{
								"source": {
									"path": "['stock']"
								},
								"sink": {
									"name": "stock",
									"type": "Int64"
								}
							},
							{
								"source": {
									"path": "['brand']"
								},
								"sink": {
									"name": "brand",
									"type": "String"
								}
							}
						],
						"collectionReference": "$['products']"
					}
				},
				"inputs": [
					{
						"referenceName": "ds_source_restapi",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "ds_sink_sql",
						"type": "DatasetReference"
					}
				]
			}
		],
		"annotations": []
	}
}